"""
predict_congestion.py
---------------------
Real-time congestion prediction using trained CatBoost model.
Implements Section 5.3 of the paper.
"""

import numpy as np
import pickle
import os
import networkx as nx
from catboost import CatBoostClassifier
from sklearn.preprocessing import MinMaxScaler


class CongestionPredictor:
    """
    Wraps the trained CatBoost model for real-time congestion prediction.

    Congestion classes:
        0 — Normal   (P_cong < 0.3)
        1 — Moderate (0.3 ≤ P_cong < 0.7)
        2 — Critical (P_cong ≥ 0.7)

    Parameters
    ----------
    model_path : str
        Path to saved model pickle file
    """

    CLASS_THRESHOLDS = [0.15, 0.5, 0.85]   # representative P_cong per class

    def __init__(self, model_path: str = 'results/models/catboost_model.pkl'):
        if not os.path.exists(model_path):
            raise FileNotFoundError(
                f"Model not found at {model_path}. "
                f"Run train_catboost.py first."
            )
        with open(model_path, 'rb') as f:
            bundle = pickle.load(f)

        self.model: CatBoostClassifier = bundle['model']
        self.scaler: MinMaxScaler      = bundle['scaler']

    def extract_features(self, G: nx.DiGraph, node: int = None,
                          path: list = None) -> np.ndarray:
        """
        Extract 18 traffic features from the network graph
        for a given node or path (Section 5.1).

        Returns
        -------
        np.ndarray of shape (1, 18)
        """
        if path and len(path) >= 2:
            # Aggregate path-level features
            delays     = [G[u][v]['delay']     for u, v in zip(path, path[1:])]
            losses     = [G[u][v]['loss_prob']  for u, v in zip(path, path[1:])]
            queues     = [G[u][v]['queue_occ']  for u, v in zip(path, path[1:])]
            bws        = [G[u][v]['bandwidth']  for u, v in zip(path, path[1:])]
            energies   = [G[u][v]['energy']     for u, v in zip(path, path[1:])]

            bw_util    = np.mean(bws)
            queue_occ  = np.max(queues)
            e2e_delay  = np.sum(delays)
            pkt_loss   = 1 - np.prod([1 - l for l in losses])
            jitter     = np.std(delays)
            hop_count  = len(path) - 1
            energy     = np.sum(energies)
        elif node is not None:
            # Node-level features (for Q-learning state)
            neighbors  = list(G.successors(node))
            if not neighbors:
                return np.zeros((1, 18))

            bws        = [G[node][v]['bandwidth'] for v in neighbors]
            queues     = [G[node][v]['queue_occ'] for v in neighbors]
            delays     = [G[node][v]['delay']     for v in neighbors]
            losses     = [G[node][v]['loss_prob'] for v in neighbors]
            energies   = [G[node][v]['energy']    for v in neighbors]

            bw_util    = np.mean(bws)
            queue_occ  = np.mean(queues)
            e2e_delay  = np.mean(delays)
            pkt_loss   = np.mean(losses)
            jitter     = np.std(delays)
            hop_count  = 1
            energy     = np.mean(energies)
            bws = delays = losses = queues = energies = [bw_util], [e2e_delay], [pkt_loss], [queue_occ], [energy]
            bws = [bw_util]; delays = [e2e_delay]; losses = [pkt_loss]
        else:
            return np.zeros((1, 18))

        # Compute temporal statistics
        mean_bw   = np.mean(bws)
        var_bw    = np.var(bws) if len(bws) > 1 else 0.0
        mean_del  = np.mean(delays)
        var_del   = np.var(delays) if len(delays) > 1 else 0.0
        mean_loss = np.mean(losses)
        var_loss  = np.var(losses) if len(losses) > 1 else 0.0

        # Trend indicators (simplified: -1 = decreasing, 0 = stable, +1 = increasing)
        trend_bw    = int(np.sign(bws[-1] - bws[0])) if len(bws) > 1 else 0
        trend_delay = int(np.sign(delays[-1] - delays[0])) if len(delays) > 1 else 0
        trend_queue = int(np.sign(queues[-1] - queues[0])) if len(queues) > 1 else 0

        lqi = (1 - pkt_loss) * (1 - queue_occ) * min(bw_util / 100, 1.0)

        features = np.array([[
            bw_util, queue_occ, e2e_delay, pkt_loss,
            jitter, hop_count, energy,
            mean_bw, var_bw, mean_del, var_del, mean_loss, var_loss,
            trend_bw, trend_delay, trend_queue,
            lqi, 1.0  # flow_count placeholder
        ]])
        return features

    def predict(self, features: np.ndarray) -> float:
        """
        Predict congestion probability from feature vector.

        Returns
        -------
        float : P_cong in [0, 1]
        """
        features_scaled = self.scaler.transform(features)
        proba           = self.model.predict_proba(features_scaled)[0]
        # P_cong is weighted sum: class 0→0.15, class 1→0.5, class 2→0.85
        p_cong = sum(p * t for p, t in zip(proba, self.CLASS_THRESHOLDS))
        return float(p_cong)

    def predict_class(self, features: np.ndarray) -> int:
        """
        Predict congestion class (0=Normal, 1=Moderate, 2=Critical).
        """
        features_scaled = self.scaler.transform(features)
        return int(self.model.predict(features_scaled)[0])

    def predict_from_graph(self, G: nx.DiGraph, path: list) -> float:
        """Convenience: extract features and predict in one call."""
        features = self.extract_features(G, path=path)
        return self.predict(features)

