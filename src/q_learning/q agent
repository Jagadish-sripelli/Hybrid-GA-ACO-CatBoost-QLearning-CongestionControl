"""
q_agent.py
----------
Distributed Q-learning agent for decentralized adaptive routing control.
Implements Section 5.4 and Equation (6) of the paper.

Q-learning update (Eq. 6):
    Q(s,a) ← Q(s,a) + α[r + γ·max_a' Q(s',a') − Q(s,a)]

Reward function (Eq. 8):
    r(s,a) = β₁·Throughput_gain − β₂·Delay_penalty − β₃·Loss_penalty
"""

import numpy as np
import networkx as nx
from typing import Tuple


class QAgent:
    """
    Decentralized Q-learning agent deployed at a single network node.

    State space:
        s = (buffer_level, delay_level, loss_level, link_quality_level)
        Each dimension discretized into 5 levels → 5^4 = 625 states

    Action space:
        Select next-hop neighbor (one action per neighbor)

    Parameters
    ----------
    node_id : int
    G : nx.DiGraph
    alpha : float
        Learning rate
    gamma : float
        Discount factor
    epsilon : float
        Initial exploration rate (epsilon-greedy)
    epsilon_min : float
    epsilon_decay : float
    beta : list[float]
        [β₁, β₂, β₃] reward weights (Eq. 8)
    seed : int
    """

    N_BINS = 5   # discretization bins per state dimension

    def __init__(self,
                 node_id: int,
                 G: nx.DiGraph,
                 alpha: float = 0.2,
                 gamma: float = 0.8,
                 epsilon: float = 1.0,
                 epsilon_min: float = 0.01,
                 epsilon_decay: float = 0.995,
                 beta: list = None,
                 seed: int = 42):

        self.node_id       = node_id
        self.G             = G
        self.alpha         = alpha
        self.gamma         = gamma
        self.epsilon       = epsilon
        self.epsilon_min   = epsilon_min
        self.epsilon_decay = epsilon_decay
        self.beta          = beta or [1.0, 0.5, 0.8]
        self.rng           = np.random.RandomState(seed)

        # Action set: list of neighbor node IDs
        self.actions = list(G.successors(node_id))

        # Q-table: state_idx → {action → Q-value}
        self.q_table = {}

    # ── State representation ──────────────────────────────────────────────────

    def _discretize(self, value: float, n_bins: int = 5) -> int:
        """Map continuous value in [0,1] to discrete bin index."""
        return min(int(value * n_bins), n_bins - 1)

    def get_state(self) -> tuple:
        """
        Observe local network state s = {buffer, delay, loss, link_quality}.
        Returns discretized state tuple.
        """
        if not self.actions:
            return (0, 0, 0, 0)

        # Aggregate over outgoing links
        queues   = [self.G[self.node_id][v]['queue_occ']  for v in self.actions]
        delays   = [self.G[self.node_id][v]['delay']       for v in self.actions]
        losses   = [self.G[self.node_id][v]['loss_prob']   for v in self.actions]
        bws      = [self.G[self.node_id][v]['bandwidth']   for v in self.actions]

        buf  = self._discretize(np.mean(queues))
        del_ = self._discretize(min(np.mean(delays) / 200.0, 1.0))
        los  = self._discretize(np.mean(losses) / 0.3)
        lqi  = self._discretize(
            (1 - np.mean(losses)) * (1 - np.mean(queues)) * min(np.mean(bws) / 100, 1.0)
        )
        return (buf, del_, los, lqi)

    # ── Q-table access ────────────────────────────────────────────────────────

    def _get_q(self, state: tuple, action: int) -> float:
        return self.q_table.get(state, {}).get(action, 0.0)

    def _set_q(self, state: tuple, action: int, value: float):
        if state not in self.q_table:
            self.q_table[state] = {}
        self.q_table[state][action] = value

    def max_q(self, state: tuple) -> float:
        """max_a' Q(s', a') for Eq. (6)."""
        if not self.actions:
            return 0.0
        return max(self._get_q(state, a) for a in self.actions)

    # ── Action selection ──────────────────────────────────────────────────────

    def select_action(self, state: tuple) -> int:
        """
        Epsilon-greedy action selection.
        Returns selected next-hop neighbor node ID.
        """
        if not self.actions:
            return None
        if self.rng.random() < self.epsilon:
            return self.rng.choice(self.actions)   # explore
        q_vals = {a: self._get_q(state, a) for a in self.actions}
        return max(q_vals, key=q_vals.get)          # exploit

    # ── Learning ──────────────────────────────────────────────────────────────

    def compute_reward(self,
                       prev_throughput: float,
                       curr_throughput: float,
                       delay: float,
                       loss: float) -> float:
        """
        Compute reward signal using Eq. (8):
            r(s,a) = β₁·Throughput_gain − β₂·Delay_penalty − β₃·Loss_penalty
        """
        throughput_gain = max(curr_throughput - prev_throughput, 0) / 100.0
        delay_penalty   = min(delay / 200.0, 1.0)
        loss_penalty    = min(loss / 0.3, 1.0)

        return (self.beta[0] * throughput_gain
                - self.beta[1] * delay_penalty
                - self.beta[2] * loss_penalty)

    def update(self,
               state: tuple,
               action: int,
               reward: float,
               next_state: tuple):
        """
        Q-table update using Eq. (6):
            Q(s,a) ← Q(s,a) + α[r + γ·max_a' Q(s',a') − Q(s,a)]
        """
        q_current = self._get_q(state, action)
        q_target  = reward + self.gamma * self.max_q(next_state)
        q_new     = q_current + self.alpha * (q_target - q_current)
        self._set_q(state, action, q_new)

        # Epsilon decay
        self.epsilon = max(self.epsilon_min, self.epsilon * self.epsilon_decay)

    def get_best_action_qvalue(self, state: tuple) -> Tuple[int, float]:
        """
        Return (best_action, Q_value) for the hybrid decision engine.
        Used in Score(R_k) = w₁·QoS + w₂·Pheromone + w₃·P_cong + w₄·Q_value
        """
        if not self.actions:
            return None, 0.0
        q_vals = {a: self._get_q(state, a) for a in self.actions}
        best   = max(q_vals, key=q_vals.get)
        # Normalize Q-value to [0, 1]
        q_max  = max(q_vals.values())
        q_min  = min(q_vals.values())
        q_norm = (q_max - q_min + 1e-9) / (abs(q_min) + q_max + 1e-9)
        return best, q_norm
